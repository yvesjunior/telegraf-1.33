import { check, sleep, Trend } from 'k6';
import http from 'k6/http';

// Define custom metric
let myTrend = new Trend('my_custom_metric');

export default function () {
  let res = http.get('https://httpbin.org/get'); // Simulate some HTTP request

  // Add metric data
  myTrend.add(res.status); // For example, using HTTP status code as the metric value
  
  check(res, {
    'status is 200': (r) => r.status === 200,
  });

  // Sleep to simulate time between requests
  sleep(1);
}



